# FleetSec Vulnerable App — variables de entorno requeridas (V-10 remediado)
#
# Uso local:
#   cp .env.example .env      # y completar con valores reales
#   docker compose up -d      # (desde app/)
#
# NUNCA commitear .env con valores reales — está en .gitignore.
# En CI: repo secrets (GitHub Actions). En prod: AWS Secrets Manager (Sprint 3).

# Secreto de firma JWT — HS256 requiere >= 32 bytes. Generar aleatorio:
#   openssl rand -base64 48
APP_JWT_SECRET=change-me-use-a-long-random-secret-min-32-bytes

# Contraseña de admin — fuerte y rotada (la vieja quedó comprometida en el historial).
APP_ADMIN_PASSWORD=change-me-strong-admin-password

# Opcional (username no es secreto; default 'admin' si se omite):
# APP_ADMIN_USERNAME=admin
