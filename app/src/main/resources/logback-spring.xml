<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de logging — V-08 REMEDIADO (CWE-359 / Ley 1581).

  Se registra la palabra de conversión %maskedMsg (PiiMaskingConverter) que redacta correos y
  secuencias numéricas largas (cédula/teléfono/id) del mensaje ANTES de escribirlo a consola o a
  disco. La redacción es transversal: cubre cualquier call site, no solo los conocidos.
-->
<configuration>

    <conversionRule conversionWord="maskedMsg"
                    converterClass="co.fleetsec.vapp.logging.PiiMaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <!-- Persiste los logs (con PII redactada por %maskedMsg) a disco. -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/fleetsec-app.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
